#!/usr/bin/env python3
"""Load bootstrap protocol 1 from the checksum-verified toolkit archive."""

import argparse
import hashlib
import io
import json
import os
import re
import subprocess
import sys
import tarfile
import urllib.request
from pathlib import Path


def main():
    root = Path(__file__).resolve().parent
    argv = sys.argv[1:]
    cache = root / ".build/toolkit"
    if (root / ".build").is_symlink() or cache.is_symlink():
        raise ValueError("Toolkit cache cannot redirect outside the checkout")
    selected = root / "toolkit.lock.json"
    maintenance = argv[:2] == ["toolkit", "sync"]
    if maintenance:
        parser = argparse.ArgumentParser(add_help=False, allow_abbrev=False)
        parser.add_argument("--base-ref")
        options, _ = parser.parse_known_args(argv[2:])
        if options.base_ref:
            revision = subprocess.check_output(
                [
                    "git",
                    "-C",
                    str(root),
                    "rev-parse",
                    "--verify",
                    "--end-of-options",
                    options.base_ref + "^{commit}",
                ],
                text=True,
            ).strip()
            lock = json.loads(
                subprocess.check_output(
                    ["git", "-C", str(root), "show", revision + ":toolkit.lock.json"]
                )
            )
        else:
            current = cache / "current"
            if not current.is_symlink() or not re.fullmatch(
                r"[a-f0-9]{64}", os.readlink(current)
            ):
                raise ValueError(
                    "Synchronization needs a verified active release or --base-ref REF"
                )
            selected = cache / (os.readlink(current) + ".lock.json")
            if selected.is_symlink() or not selected.is_file():
                raise ValueError(
                    "Active selection record is missing or unsafe; use --base-ref REF"
                )
            lock = json.loads(selected.read_text())
            if not isinstance(lock, dict) or lock.get("sha256") != os.readlink(current):
                raise ValueError("Active selection record differs from its pointer")
    else:
        lock = json.loads(selected.read_text())
    if (
        not isinstance(lock, dict)
        or lock.get("schema") != 1
        or not all(
            isinstance(lock.get(key), str) and re.fullmatch(pattern, lock[key])
            for key, pattern in {
                "repository": r"[\w.-]+/[\w.-]+",
                "version": r"v\d+\.\d+\.\d+(?:-[\w.]+)?",
                "sha256": r"[a-f0-9]{64}",
            }.items()
        )
    ):
        raise ValueError("Invalid toolkit selection")
    archive = cache / (lock["sha256"] + ".tar.gz")
    if archive.is_symlink():
        raise ValueError("Toolkit archive cache cannot contain symlinks")
    supplied = os.environ.get("JELLYFIN_PLUGIN_TOOLKIT_ARCHIVE")
    embedded = root / "build-support/toolkit.tar.gz"
    if supplied or (
        embedded.is_file()
        and lock == json.loads((root / "toolkit.lock.json").read_text())
    ):
        source = Path(supplied) if supplied else embedded
    else:
        source = archive if archive.is_file() else embedded
    if supplied or source.is_file():
        with source.open("rb") as stream:
            payload = stream.read(100_000_001)
    else:
        if not (
            (maintenance and "--download" in argv)
            or argv[:1] in (["bootstrap"], ["_install"])
        ):
            raise ValueError("Locked toolkit is missing; run ./plugin bootstrap")
        version = lock["version"]
        url = f"https://github.com/{lock['repository']}/releases/download/{version}/jellyfin-plugin-toolkit-{version[1:]}.tar.gz"
        with urllib.request.urlopen(url, timeout=60) as response:
            payload = response.read(100_000_001)
    if len(payload) > 100_000_000:
        raise ValueError("Toolkit archive exceeds size limit")
    if hashlib.sha256(payload).hexdigest() != lock["sha256"]:
        raise ValueError(
            "Toolkit archive SHA-256 mismatch; working installation preserved"
        )
    entrypoint = "jellyfin_plugin_toolkit/bootstrap.py"
    with tarfile.open(fileobj=io.BytesIO(payload), mode="r:gz") as package:
        entries = [member for member in package if member.name == entrypoint]
        if (
            len(entries) != 1
            or not entries[0].isfile()
            or not 0 < entries[0].size <= 65_536
        ):
            raise ValueError("Unsupported toolkit bootstrap protocol 1")
        member_stream = package.extractfile(entries[0])
        if member_stream is None:
            raise ValueError("Missing toolkit bootstrap entrypoint")
        with member_stream:
            code = member_stream.read(65_537)
    namespace: dict[str, object] = {
        "__name__": "_verified_toolkit_bootstrap",
        "__file__": entrypoint,
    }
    exec(compile(code, entrypoint, "exec"), namespace)
    dispatch = namespace.get("main")
    if namespace.get("BOOTSTRAP_PROTOCOL") != 1 or not callable(dispatch):
        raise ValueError("Unsupported toolkit bootstrap protocol 1")
    return dispatch(root, lock, payload, argv)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (
        ValueError,
        OSError,
        tarfile.TarError,
        subprocess.CalledProcessError,
    ) as error:
        raise SystemExit(str(error)) from error
