{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": ["/^pyproject\\.toml$/"],
            "matchStrings": [
                "https://github\\.com/rakuzen25/jellyfin-plugin-toolkit/releases/download/(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)/jellyfin_plugin_toolkit-[0-9]+\\.[0-9]+\\.[0-9]+-py3-none-any\\.whl"
            ],
            "depNameTemplate": "rakuzen25/jellyfin-plugin-toolkit",
            "datasourceTemplate": "github-releases",
            "versioningTemplate": "semver",
            "autoReplaceStringTemplate": "https://github.com/rakuzen25/jellyfin-plugin-toolkit/releases/download/{{newValue}}/jellyfin_plugin_toolkit-{{replace \"v\" \"\" newValue}}-py3-none-any.whl"
        },
        {
            "customType": "regex",
            "managerFilePatterns": ["/^plugin\\.toml$/"],
            "matchStrings": ["\"(?<depName>mcr\\.microsoft\\.com/playwright):(?<currentValue>[^\"@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""],
            "datasourceTemplate": "docker",
            "versioningTemplate": "docker"
        }
    ],
    "packageRules": [
        {
            "description": ["Toolkit references are derived by trusted synchronization, never updated independently."],
            "matchPackageNames": ["rakuzen25/jellyfin-plugin-toolkit", "rakuzen25/jellyfin-plugin-toolkit/**"],
            "groupName": "Jellyfin plugin toolkit",
            "groupSlug": "jellyfin-plugin-toolkit",
            "automerge": false,
            "separateMajorMinor": false,
            "enabled": false
        },
        {
            "description": ["Only the canonical toolkit wheel URL may select a new published release."],
            "matchManagers": ["custom.regex"],
            "matchDatasources": ["github-releases"],
            "matchPackageNames": ["rakuzen25/jellyfin-plugin-toolkit"],
            "matchFileNames": ["pyproject.toml"],
            "commitMessageTopic": "jellyfin plugin toolkit",
            "commitMessageExtra": "",
            "enabled": true,
            "minimumReleaseAge": null,
            "minimumReleaseAgeBuffer": null
        },
        {
            "matchPackageNames": ["rakuzen25/jellyfin-plugin-toolkit", "rakuzen25/jellyfin-plugin-toolkit/**"],
            "matchUpdateTypes": ["major"],
            "dependencyDashboardApproval": true,
            "labels": ["toolkit-major-review"]
        }
    ],
    "description": ["The published toolkit wheel selects the version; trusted synchronization derives the uv lockfile, workflow and preset updates."]
}
