{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["github>rakuzen25/jellyfin-plugin-toolkit:tooling"],
    "gitIgnoredAuthors": ["342669125+finchaser-3-0[bot]@users.noreply.github.com"],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": ["/^src/jellyfin_plugin_toolkit/resources/configs/validators\\.json$/"],
            "matchStrings": ["\"(?<depName>[^\"\\s]+):(?<currentValue>[^\"@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""],
            "datasourceTemplate": "docker",
            "versioningTemplate": "docker"
        }
    ]
}
